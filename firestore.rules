rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /adminYearContent/{documentId} {
      allow read, write: if true;
    }

    match /teamProject/{documentId} {
      allow read, write: if true;
    }

    match /globalwinner/{documentId} {
      allow read, write: if true;
    }

    match /organizers/{documentId} {
      allow read, write: if true;
    }

    match /pastWinners/{documentId} {
      allow read, write: if true;
    }

    match /globalSettings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read: if true;
      // Allow writes to other docs open for now, but you should lock these down too!
      allow write: if true;
    }
  }
}
